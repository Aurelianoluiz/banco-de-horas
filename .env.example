# PostgreSQL
DATABASE_URL=postgres://usuario:senha@localhost:5432/banco_de_horas

# Auth — gere um segredo longo e aleatório para produção
AUTH_TOKEN_SECRET=troque-por-um-segredo-longo-e-aleatorio

# HTTP
PORT=3000

# Produção — HTTPS deve ser terminado no reverse proxy/load balancer.
# Para execução HTTPS direta no Node, forneça ambos os arquivos e habilite TLS no ambiente.
TLS_CERT_FILE=
TLS_KEY_FILE=

# Homologação — somente para o seed local/CI, nunca use estas variáveis em produção
SEED_ADMIN_PASSWORD=defina-localmente
SEED_GESTOR_PASSWORD=defina-localmente
SEED_COLABORADOR_PASSWORD=defina-localmente
